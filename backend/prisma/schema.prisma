generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String     @id @default(uuid())
  employeeId   String     @unique
  email        String?    @unique
  passwordHash String
  otpEnabled   Boolean    @default(false)
  otpSecret    String?
  isActive     Boolean    @default(true)
  roleId       String
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  employee     Employee?
  branch       Branch     @relation(fields: [branchId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
}

model Employee {
  id               String             @id @default(uuid())
  userId           String             @unique
  firstName        String
  lastName         String
  department       String?
  designation      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customFields     Json?
  email            String?
  emergencyContact String?
  emergencyPhone   String?
  employmentType   String             @default("FULL_TIME")
  joinDate         DateTime?
  managerId        String?
  mobile           String?
  admissions       Admission[]
  attendances      Attendance[]
  enrollments      CourseEnrollment[]
  manager          Employee?          @relation("ManagerToEmployee", fields: [managerId], references: [id])
  directReports    Employee[]         @relation("ManagerToEmployee")
  user             User               @relation(fields: [userId], references: [id])
  givenFeedbacks   Feedback[]         @relation("FeedbackGiver")
  rcvdFeedbacks    Feedback[]         @relation("FeedbackReceiver")
  ownedGoals       Goal[]             @relation("GoalOwner")
  hrDocuments      HrDocument[]
  interviews       InterviewSlot[]    @relation("Interviewer")
  createdJobs      JobDefinition[]    @relation("HiringManager")
  onboardingTasks  OnboardingTask[]
  oneOnOnesAsEmp   OneOnOneAgenda[]   @relation("EmpAgenda")
  oneOnOnesAsMgr   OneOnOneAgenda[]   @relation("MgrAgenda")
  payrolls         Payroll[]
  shifts           ShiftSlot[]
  surveys          SurveyResponse[]
  visits           Visit[]
  surgeries        SurgerySchedule[]
  StaffCredential  StaffCredential[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Patient {
  id              String               @id @default(uuid())
  uhid            String               @unique
  firstName       String
  lastName        String
  age             Int
  dob             DateTime?
  gender          String
  bloodGroup      String?
  maritalStatus   String?
  mobile          String
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  emgName         String?
  emgRelation     String?
  emgMobile       String?
  tpaName         String?
  policyNo        String?
  insuranceValid  DateTime?
  coverageAmt     Float?
  referredBy      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  safetyRiskLevel String?
  safetyFindings  Json?
  receivables     AccountsReceivable[]
  admissions      Admission[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  referrals       Referral[]
  visits          Visit[]
  surgeries       SurgerySchedule[]
  claims          Claim[]
}

model Visit {
  id                  String               @id @default(uuid())
  patientId           String
  doctorId            String
  department          String
  tokenNo             String
  status              String               @default("WAITING")
  notes               String?
  symptoms            String?
  diagnosis           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scribeStatus        String               @default("INACTIVE")
  audioStreamUrl      String?
  soapNote            Json?
  consentToRecord     Boolean              @default(false)
  bills               Bill[]
  labOrders           LabOrder[]
  prescriptions       Prescription[]
  doctor              Employee             @relation(fields: [doctorId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  telemedicineSession TelemedicineSession?
}

model Bill {
  id                   String              @id @default(uuid())
  billNo               String              @unique
  patientId            String?
  visitId              String?
  admissionId          String?
  type                 String
  subTotal             Float
  gstAmount            Float
  discount             Float               @default(0)
  netPayable           Float
  insuranceClaimAmount Float               @default(0)
  patientPayable       Float               @default(0)
  paymentMode          String
  status               String              @default("UNPAID")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  admission            Admission?          @relation(fields: [admissionId], references: [id])
  visit                Visit?              @relation(fields: [visitId], references: [id])
  insuranceScrubLogs   InsuranceScrubLog[]
  claims               Claim[]
}

model LabOrder {
  id             String    @id @default(uuid())
  patientId      String
  visitId        String?
  testName       String
  sacCode        String    @default("999316")
  price          Float
  status         String    @default("PENDING")
  resultText     String?
  reportPdfUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priority       String    @default("ROUTINE")
  resultValue    Float?
  barcode        String?
  collectedAt    DateTime?
  resultsPayload Json?
  sampleStatus   String    @default("PENDING")
  aiSummary      Json?
  patient        Patient   @relation(fields: [patientId], references: [id])
  visit          Visit?    @relation(fields: [visitId], references: [id])
}

model Prescription {
  id        String   @id @default(uuid())
  patientId String
  visitId   String
  medicines Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
  visit     Visit    @relation(fields: [visitId], references: [id])
}

model Ward {
  id        String   @id @default(uuid())
  name      String
  type      String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beds      Bed[]
  devices   Device[]
}

model Bed {
  id         String      @id @default(uuid())
  bedNumber  String
  wardId     String
  dailyRent  Float
  status     String      @default("AVAILABLE")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  admissions Admission[]
  ward       Ward        @relation(fields: [wardId], references: [id])
}

model Admission {
  id            String          @id @default(uuid())
  patientId     String
  doctorId      String
  bedId         String
  status        String          @default("ADMITTED")
  admissionDate DateTime        @default(now())
  dischargeDate DateTime?
  depositAmount Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bed           Bed             @relation(fields: [bedId], references: [id])
  doctor        Employee        @relation(fields: [doctorId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  bills         Bill[]
  ipdCharges    IpdCharge[]
  nursingVitals NursingVitals[]
}

model OperatingTheater {
  id        String            @id @default(uuid())
  name      String            @unique
  status    String            @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  surgeries SurgerySchedule[]
}

model SurgerySchedule {
  id          String   @id @default(uuid())
  patientId   String
  surgeonId   String
  otId        String
  surgeryName String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient          @relation(fields: [patientId], references: [id])
  surgeon Employee         @relation(fields: [surgeonId], references: [id])
  ot      OperatingTheater @relation(fields: [otId], references: [id])
}

model IpdCharge {
  id          String    @id @default(uuid())
  admissionId String
  chargeType  String
  description String
  amount      Float
  dateAdded   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  admission   Admission @relation(fields: [admissionId], references: [id])
}

model NursingVitals {
  id              String    @id @default(uuid())
  admissionId     String
  bp              String?
  heartRate       Int?
  temperature     Float?
  spo2            Int?
  respiratoryRate Int?
  notes           String?
  ewsScore        Int?
  ewsRiskLevel    String?
  recordedBy      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  admission       Admission @relation(fields: [admissionId], references: [id])
}

model LabCatalog {
  id           String   @id @default(uuid())
  testName     String   @unique
  department   String
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  criticalMax  Float?
  criticalMin  Float?
  unit         String?
  parameters   Json?
  loincCode    String?
  isNotifiable Boolean  @default(false)
}

model Notification {
  id           String   @id @default(uuid())
  targetUserId String
  type         String
  title        String
  body         String
  priority     String   @default("NORMAL")
  isRead       Boolean  @default(false)
  visitId      String?
  labOrderId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Referral {
  id            String   @id @default(uuid())
  fromDoctorId  String
  patientId     String
  referralToken String   @unique @default(uuid())
  toHospital    String
  reason        String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id])
}

model MedicineInventory {
  id                String   @id @default(uuid())
  drugName          String   @unique
  manufacturer      String?
  batchNo           String
  expiryDate        DateTime
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(50)
  unitPrice         Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime  @default(now())
  status     String
  checkIn    DateTime?
  checkOut   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model Payroll {
  id          String    @id @default(uuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  allowances  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  status      String    @default("PENDING")
  paymentDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
}

model ShiftSlot {
  id            String   @id @default(uuid())
  employeeId    String
  startTime     DateTime
  endTime       DateTime
  department    String?
  roleType      String?
  status        String   @default("SCHEDULED")
  isBurnoutRisk Boolean  @default(false)
  burnoutReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id])
}

model Ledger {
  id           String        @id @default(uuid())
  name         String        @unique
  group        String
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accountType  String        @default("DETAIL")
  code         String?       @unique
  isActive     Boolean       @default(true)
  parentId     String?
  journalLines JournalLine[]
  parent       Ledger?       @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children     Ledger[]      @relation("LedgerHierarchy")
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  ledgerId      String
  type          String
  amount        Float
  description   String
  referenceId   String?
  referenceType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ledger        Ledger   @relation(fields: [ledgerId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  voucherNo   String   @unique
  category    String
  description String
  amount      Float
  gstAmount   Float    @default(0)
  tdsAmount   Float    @default(0)
  netAmount   Float
  paymentMode String
  status      String   @default("PENDING")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JournalEntry {
  id            String        @id @default(uuid())
  entryNo       String        @unique
  date          DateTime      @default(now())
  narration     String
  status        String        @default("POSTED")
  referenceId   String?
  referenceType String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         JournalLine[]
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  ledgerId       String
  debit          Float        @default(0)
  credit         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  ledger         Ledger       @relation(fields: [ledgerId], references: [id])
}

model AccountsReceivable {
  id        String   @id @default(uuid())
  patientId String
  billId    String?
  amount    Float
  dueDate   DateTime @default(now())
  status    String   @default("OUTSTANDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model AccountsPayable {
  id         String   @id @default(uuid())
  vendorName String
  expenseId  String?
  amount     Float
  dueDate    DateTime @default(now())
  status     String   @default("OUTSTANDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FinancialPeriod {
  id         String    @id @default(uuid())
  month      Int
  year       Int
  status     String    @default("OPEN")
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([month, year])
}

model Budget {
  id         String   @id @default(uuid())
  department String
  month      Int
  year       Int
  allocated  Float
  spent      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([department, month, year])
}

model HrDocument {
  id         String   @id @default(uuid())
  employeeId String
  title      String
  url        String
  type       String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model OnboardingWorkflow {
  id          String           @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tasks       OnboardingTask[]
}

model OnboardingTask {
  id         String             @id @default(uuid())
  workflowId String
  employeeId String
  taskName   String
  assignedTo String
  status     String             @default("PENDING")
  dueDate    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  employee   Employee           @relation(fields: [employeeId], references: [id])
  workflow   OnboardingWorkflow @relation(fields: [workflowId], references: [id])
}

model JobDefinition {
  id              String      @id @default(uuid())
  title           String
  department      String
  description     String
  keywords        String?
  status          String      @default("DRAFT")
  hiringManagerId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  candidates      Candidate[]
  hiringManager   Employee    @relation("HiringManager", fields: [hiringManagerId], references: [id])
}

model Candidate {
  id         String               @id @default(uuid())
  jobId      String
  firstName  String
  lastName   String
  email      String
  resumeUrl  String?
  status     String               @default("APPLIED")
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  job        JobDefinition        @relation(fields: [jobId], references: [id])
  scorecards InterviewScorecard[]
  interviews InterviewSlot[]
}

model InterviewSlot {
  id            String    @id @default(uuid())
  candidateId   String
  interviewerId String
  scheduledAt   DateTime
  durationMins  Int       @default(45)
  meetingLink   String?
  status        String    @default("SCHEDULED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  interviewer   Employee  @relation("Interviewer", fields: [interviewerId], references: [id])
}

model InterviewScorecard {
  id             String    @id @default(uuid())
  candidateId    String
  interviewerId  String
  competencies   Json
  notes          String?
  recommendation String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  candidate      Candidate @relation(fields: [candidateId], references: [id])
}

model Goal {
  id           String    @id @default(uuid())
  title        String
  level        String
  ownerId      String?
  parentGoalId String?
  progress     Int       @default(0)
  keyResults   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  owner        Employee? @relation("GoalOwner", fields: [ownerId], references: [id])
  parentGoal   Goal?     @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  subGoals     Goal[]    @relation("GoalHierarchy")
}

model Feedback {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  content    String
  type       String   @default("PUBLIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fromUser   Employee @relation("FeedbackGiver", fields: [fromUserId], references: [id])
  toUser     Employee @relation("FeedbackReceiver", fields: [toUserId], references: [id])
}

model OneOnOneAgenda {
  id          String   @id @default(uuid())
  managerId   String
  employeeId  String
  date        DateTime
  topics      Json?
  actionItems Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation("EmpAgenda", fields: [employeeId], references: [id])
  manager     Employee @relation("MgrAgenda", fields: [managerId], references: [id])
}

model Survey {
  id        String           @id @default(uuid())
  title     String
  questions Json
  status    String           @default("ACTIVE")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  responses SurveyResponse[]
}

model SurveyResponse {
  id         String    @id @default(uuid())
  surveyId   String
  employeeId String?
  answers    Json
  sentiment  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee? @relation(fields: [employeeId], references: [id])
  survey     Survey    @relation(fields: [surveyId], references: [id])
}

model Course {
  id          String             @id @default(uuid())
  title       String
  description String
  department  String?
  tags        String[]
  modules     Json
  requiredFor String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments CourseEnrollment[]
}

model CourseEnrollment {
  id             String    @id @default(uuid())
  courseId       String
  employeeId     String
  status         String    @default("ENROLLED")
  progress       Int       @default(0)
  completionDate DateTime?
  aiSuggested    Boolean   @default(false)
  matchScore     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course    @relation(fields: [courseId], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@unique([courseId, employeeId])
}

model Device {
  id         String   @id @default(uuid())
  deviceName String
  macAddress String   @unique
  wardId     String
  status     String // ONLINE, OFFLINE, ALERT
  lastSync   DateTime @default(now())
  ward       Ward     @relation(fields: [wardId], references: [id])
}

model TelemedicineSession {
  id           String    @id @default(uuid())
  visitId      String    @unique
  meetingLink  String
  recordingUrl String?
  startTime    DateTime
  endTime      DateTime?
  visit        Visit     @relation(fields: [visitId], references: [id])
}

model InsuranceScrubLog {
  id         String @id @default(uuid())
  billId     String
  findings   Json // Array of detected errors or compliance flags
  scrubbedBy String @default("AI_ENGINE")
  bill       Bill   @relation(fields: [billId], references: [id])
}

// Medisys HMS v5.1 - GUDHR Schema Extensions

model StaffCredential {
  id               String   @id @default(uuid())
  employeeId       String
  credentialName   String // e.g., "State Medical Council License", "ACLS", "BLS"
  licenseNumber    String   @unique
  issuingAuthority String
  expiryDate       DateTime
  status           String   @default("ACTIVE") // ACTIVE, EXPIRING, EXPIRED
  verifiedDocUrl   String // Secure Supabase Storage Bucket pointer
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

model OpenShiftBid {
  id               String   @id @default(uuid())
  shiftSlotId      String
  biddingStaffId   String
  bidTimestamp     DateTime @default(now())
  incentivePayRate Float    @default(1.0) // Multiplier for premium/crisis shifts (e.g., 1.5x)
  bidStatus        String   @default("PENDING") // PENDING, APPROVED, REJECTED, OVERRULED
  justification    String? // Mandatory text if overrule logic is applied
  processedBy      String? // User ID of the supervisor who acted on the bid

  @@index([shiftSlotId])
  @@index([biddingStaffId])
}

model WorkforceDemandForecast {
  id                 String   @id @default(uuid())
  department         String // e.g., "ICU", "ER", "NICU", "OPD-Pediatrics"
  forecastDate       DateTime
  predictedCensus    Int
  requiredStaffRatio Float // Staff-to-patient baseline ratio metric
  confidenceInterval Float
  createdAt          DateTime @default(now())
}

model BurnoutMetrics {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  burnoutIndex     Float // Aggregated scale from 0.00 to 1.00
  consecutiveHours Float
  absenteeismCount Int
  sentimentDelta   Float // Negative/Positive shift from pulse surveys
  updatedAt        DateTime @updatedAt

  @@index([burnoutIndex])
}

// Medisys HMS v5.1 - Phase 14c: Insurance Claim Lifecycle & TPA
model InsuranceProvider {
  id           String   @id @default(uuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  portalUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  claims       Claim[]
}

model Claim {
  id              String            @id @default(uuid())
  claimNumber     String            @unique
  billId          String
  patientId       String
  providerId      String
  status          String            @default("DRAFT") // DRAFT, SUBMITTED, IN_PROCESS, APPROVED, DENIED, PARTIAL
  requestedAmount Float
  approvedAmount  Float?
  submissionDate  DateTime?
  paymentDate     DateTime?
  denialReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bill            Bill              @relation(fields: [billId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  provider        InsuranceProvider @relation(fields: [providerId], references: [id])
  documents       ClaimDocument[]

  @@index([status])
  @@index([billId])
  @@index([providerId])
}

model ClaimDocument {
  id           String   @id @default(uuid())
  claimId      String
  documentType String   // EOB, DISCHARGE_SUMMARY, PRE_AUTH
  fileUrl      String
  uploadedAt   DateTime @default(now())
  claim        Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}
